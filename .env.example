# Copy to .env and fill in. .env is gitignored; this template is safe to commit.
#
# ─── Solana / Sponsor ────────────────────────────────────────────────
# Server-side base-layer devnet RPC for the sponsor relay (initialize/delegate).
# Use a free-tier keyed provider (e.g. Alchemy devnet:
#   https://solana-devnet.g.alchemy.com/v2/<KEY>)
# Never prefix with VITE_ — that would ship the key into the browser bundle.
GFG_DEVNET_RPC=

# Sponsor wallet keypair (JSON array of 64 ints, solana CLI format).
# Default fallback: ~/.config/solana/id.json
# GFG_Gasless_Sponsor_Keypair=

# ─── Dynamic (auth provider — source of truth for user search) ───────
# Found in: Dynamic Dashboard → Developers → SDK and API Keys
# Environment ID: identifies your Sandbox or Live settings.
DYNAMIC_ENV_ID=
# API Token: create under "API Tokens" (max 10 per env).
# Used server-side only for Management API calls (user search in admin recovery tool).
DYNAMIC_API_TOKEN=

# ─── Vercel deployment (optional overrides) ──────────────────────────
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
